[mysqld]
# D-5: case-insensitive (igual ao Windows). Em Docker o data dir nasce VAZIO no 1o boot,
# entao a flag pega de primeira (sem o reinit manual que o MySQL 8 normal exige).
lower_case_table_names=1
# D-6a: charset utf8mb4 (mata mojibake na origem)
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
# D-4: connector conecta direto (sem caching_sha2 sobre conexao insegura)
default-authentication-plugin=mysql_native_password
# export de PDF guardado em base64 (LONGTEXT) pode estourar o pacote -> 64MB
max_allowed_packet=67108864
