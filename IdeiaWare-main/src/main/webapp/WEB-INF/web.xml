         /erros/500.jsp (existia mas nao estava mapeada!). Antes, excecao nao-tratada
         mostrava o STACK TRACE cru pro usuario (feio + vaza info interna). -->
    <error-page>
        <error-code>500</error-code>
        <location>/erros/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/erros/500.jsp</location>
    </error-page>

    <!-- ENC-01: default UTF-8 para JSPs/fragmentos sem diretiva pageEncoding (o
         default do JSP seria ISO-8859-1). Padroniza tudo em UTF-8 + cobre os
         includes (headerCookies/canva-footer) junto com o banco utf8mb4. -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>
