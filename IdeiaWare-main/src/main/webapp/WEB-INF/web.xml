<?xml version="1.0" encoding="UTF-8"?>
<web-app id="WebApp_ID" version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <display-name>LIC</display-name>

    <!-- ENC-03: FORCA UTF-8 na leitura dos parametros (corpo do POST) ANTES de tudo.
         Tem que ser o PRIMEIRO filtro. Sem ele, o CsrfFilter le request.getParameter
         ("csrfToken") no POST e dispara o parsing do corpo com o encoding default
         (ISO-8859-1) ANTES do servlet chamar setCharacterEncoding("UTF-8") -> o
         setCharacterEncoding vira no-op e os acentos viram mojibake ("horÃ¡rio").
         Filtro NATIVO do Tomcat (catalina.jar, sem dependencia). Equivale ao
         CharacterEncodingFilter que o Toolkit ja tem (ENC-02). -->
    <filter>
        <filter-name>setCharacterEncoding</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>setCharacterEncoding</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- SEC-01: headers de seguranca via filtro NATIVO do Tomcat
         (HttpHeaderSecurityFilter, em catalina.jar - sem dependencia extra).
         Adiciona: X-Content-Type-Options: nosniff (impede MIME-sniffing) e
         X-Frame-Options: SAMEORIGIN (anti-clickjacking). HSTS fica DESLIGADO
         (dev e http; ligar so em producao https mudando hstsEnabled p/ true). -->
    <filter>
        <filter-name>httpHeaderSecurity</filter-name>
        <filter-class>org.apache.catalina.filters.HttpHeaderSecurityFilter</filter-class>
        <init-param>
            <param-name>hstsEnabled</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>antiClickJackingOption</param-name>
            <param-value>SAMEORIGIN</param-value>
        </init-param>
        <init-param>
            <param-name>blockContentTypeSniffingEnabled</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>httpHeaderSecurity</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- SEC-26: Referrer-Policy (o filtro nativo do Tomcat acima nao cobre esse header).
         Ver SecurityHeadersFilter pro raciocinio de NAO incluir CSP aqui ainda. -->
    <filter>
        <filter-name>securityHeadersFilter</filter-name>
        <filter-class>edu.unisc.lic.util.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>securityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- CSRF-02: protecao CSRF por token (double-submit cookie). Gera/valida o cookie
         XSRF-TOKEN e exige o token (param csrfToken ou header X-CSRF-Token) em todo
         POST. O campo nos forms e o header no AJAX vem do resources/js/csrf.js. -->
    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>edu.unisc.lic.util.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>csrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- SEC-25: endpoints de escrita (colaboracao/canvas/storytelling) so aceitam POST.
         Bloqueia GET nesses paths (405) -> fecha "CSRF por GET" (mudanca de estado por
         link). Os chamadores legitimos ja sao todos POST. -->
    <filter>
        <filter-name>postOnlyFilter</filter-name>
        <filter-class>edu.unisc.lic.util.PostOnlyFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>postOnlyFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- RATE-LIMIT: limite de tentativas por IP em login/reset de senha/cadastro
         (nenhum desses 3 endpoints tinha protecao contra brute-force/spam automatizado). -->
    <filter>
        <filter-name>rateLimitFilter</filter-name>
        <filter-class>edu.unisc.lic.util.RateLimitFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>rateLimitFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- SEC-02: cookie de sessao com HttpOnly (JS nao le o JSESSIONID) e apenas
         via cookie (sem session-id na URL, evita fixation por link). SameSite=Lax
         e setado no META-INF/context.xml. 'secure' fica DESLIGADO (dev http;
         ligar em producao https). -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

