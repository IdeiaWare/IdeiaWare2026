<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <!-- Configurações de Conexão com o Banco de Dados -->
        <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <!-- useUnicode + characterEncoding=UTF-8: FORCA a conexao em UTF-8. Sem isto, o
             connector 5.1 nao reconhece a collation padrao do MySQL 8 e negocia errado
             -> acentos viram mojibake ("horÃ¡rio"). So afeta dados do banco (o HTML ja
             e UTF-8). No MySQL 5 local passava; no MySQL 8 do servidor quebra. -->
        <property name="connection.url">jdbc:mysql://127.0.0.1:3306/lic_bd?useSSL=false&amp;useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true</property>
        <property name="connection.username">root</property>
        <property name="connection.password">root</property>

        <!-- SQL dialect -->
        <property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>

        <!-- CASE-FIX (2026-06-23): forca nomes de tabela em minusculo. Sem isto, no MySQL
             do Linux (case-sensitive) as entidades com maiuscula (Ideia, Usuario, Canva,
             Export_File...) nao achariam as tabelas reais minusculas. -->
        <property name="hibernate.physical_naming_strategy">edu.unisc.lic.util.LowerCaseTableNamingStrategy</property>

        <!-- Gerenciamento do Contexto das Sessões -->
        <property name="current_session_context_class">thread</property>

        <!-- Cache de Segundo Nível -->
        <property name="cache.provider_class">org.hibernate.cache.internal.NoCacheProvider</property>

        <!-- Mostra as SQLs Geradas -->
        <property name="show_sql">true</property>

        <!-- Cria as tabelas do banco de dados -->
        <property name="hbm2ddl.auto">update</property>
		
        <!-- Mapeamento das entidades -->
        <mapping class="edu.unisc.lic.domain.ColaboracaoIdeia" />
        <mapping class="edu.unisc.lic.domain.ElementosStorytelling" />
        <mapping class="edu.unisc.lic.domain.ExportFile" />
        <mapping class="edu.unisc.lic.domain.Ideia" />
        <mapping class="edu.unisc.lic.domain.IdeiaUsuario" />
        <mapping class="edu.unisc.lic.domain.LogColaboracao" />
        <mapping class="edu.unisc.lic.domain.Storytelling" />
        <mapping class="edu.unisc.lic.domain.Usuario" />
        <mapping class="edu.unisc.lic.domain.Canva" />
        <mapping class="edu.unisc.lic.domain.Canvaexport" />
                
    </session-factory>

</hibernate-configuration>