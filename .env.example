# Copie para .env e preencha. O .env fica no .gitignore -> NUNCA commitar.
#   cp .env.example .env

# --- Banco ---
DB_NAME=lic_bd
DB_PASS=root                 # senha do root do MySQL (use uma forte em prod)

# --- Hibernate ---
HBM2DDL=validate             # prod=validate; o override de dev usa update
SHOW_SQL=false

# --- SendGrid (envio de e-mail: reset de senha, etc.) ---
# REVOGUE a chave antiga (vazou no Git) e gere uma nova. Vazio = nao envia e-mail.
SENDGRID_API_KEY=

# --- Chave AES (16/24/32 bytes) ---
# Efetivamente legado/morto (so o cfgbanco.txt inexistente usava). Pode manter o default.
AES_KEY=1234567890123456

# --- Segredo HMAC da auth do Toolkit (SEC-23) ---
# TROQUE por um valor proprio aleatorio (32+ chars). O MESMO vale p/ LIC e Toolkit.
CAIXA_HMAC_SECRET=7f3a9c1e8b5d2406af91e7c3b8d54a02e6f1a9c4d7b3e80f
